{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/checklistEditor.ts",
    "src/checklistImport.ts",
    "src/checklistStorage.ts",
    "src/roundDirty.ts",
    "src/whatsNew.ts",
    "src/merge/mergeRounds.ts",
    "src/merge/loadRoundFile.ts",
    "src/merge/mergedDocx.ts",
    "src/merge/useMergeFiles.ts",
    "src/roundExportDocx.ts",
    "src/docx.ts",
    "src/roundData.ts",
    "src/photoImage.ts",
    "src/localId.ts"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  }
}

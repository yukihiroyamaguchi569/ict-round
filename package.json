{
  "name": "icn-round-app",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.19.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build && node scripts/build-docs.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json",
    "typecheck:e2e": "tsc -b tsconfig.e2e.json",
    "test:mutation": "stryker run",
    "verify": "npm run lint && npm test && npm run build",
    "verify:full": "npm run verify && npm run typecheck:e2e && npm run test:e2e && npm run test:mutation"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "docx": "^9.8.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.11.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
